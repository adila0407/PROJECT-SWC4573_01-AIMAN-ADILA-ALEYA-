# ---------------------------------------------------------
# Functional Programming
# ---------------------------------------------------------

average_scores = list(
    map(
        lambda project: project.calculate_average(),
        projects
    )
)

print("===== PROJECT AVERAGES =====")

for project, average in zip(projects, average_scores):

    print(
        project.project_id,
        "-",
        project.title,
        ":",
        round(average, 2)
    )

print()


# ---------------------------------------------------------
# Final Pitching Round
# Average score >= 80
# ---------------------------------------------------------

top_projects = list(
    filter(
        lambda project: project.calculate_average() >= 80,
        projects
    )
)


print("===== FINAL PITCHING ROUND =====")

for project in top_projects:

    print(
        project.project_id,
        "-",
        project.title,
        ":",
        round(project.calculate_average(), 2)
    )

print()

# ---------------------------------------------------------
# Winning Project
# ---------------------------------------------------------

winning_project = reduce(
    lambda project1, project2:
        project1
        if project1.calculate_average()
        >= project2.calculate_average()
        else project2,
    projects
)


print("===== WINNING PROJECT =====")

print("Project ID :", winning_project.project_id)
print("Title      :", winning_project.title)
print("Category   :", winning_project.category)
print("Average    :", round(
    winning_project.calculate_average(), 2
))

print()

