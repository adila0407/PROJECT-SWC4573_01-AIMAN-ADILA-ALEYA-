import pandas as pd
from functools import reduce


# ---------------------------------------------------------
# Object-Oriented Programming
# ---------------------------------------------------------

class InnovationProject:

    def __init__(self, project_id, title, category, team_members, scores):
        self.project_id = project_id
        self.title = title
        self.category = category
        self.team_members = team_members
        self.scores = scores

    def calculate_average(self):
        if not self.scores:
            return 0

        return sum(self.scores) / len(self.scores)

    def predict_commercialization(self):

        average = self.calculate_average()

        if average >= 85:
            return "High"

        elif average >= 70:
            return "Medium"

        else:
            return "Low"

    def display_project(self):

        print("Project ID       :", self.project_id)
        print("Title            :", self.title)
        print("Category         :", self.category)
        print("Team Members     :", ", ".join(self.team_members))
        print("Scores           :", self.scores)
        print("Average Score    :", round(self.calculate_average(), 2))
        print("Commercialization:", self.predict_commercialization())
        print()


