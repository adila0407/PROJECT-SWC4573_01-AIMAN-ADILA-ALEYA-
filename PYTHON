# ---------------------------------------------------------
# Functional Features
# ---------------------------------------------------------

average_scores = list(
    map(lambda p: p.calculate_average(), project_list)
)

top_projects = list(
    filter(lambda p: p.calculate_average() >= 80, project_list)
)

