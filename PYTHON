        ["Adila", "Aleya"],
        [92, 90, 95]
    ),

    InnovationProject(
        "P004",
        "Smart Farming System",
        "Web Development",
        ["Aiman", "Aleya"],
        [75, 79, 77]
    ),

    InnovationProject(
        "P005",
