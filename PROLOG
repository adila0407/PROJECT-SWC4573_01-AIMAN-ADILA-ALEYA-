% PROJECT FACTS
% project(ProjectID, Category, Score)
project(p001, artificial_intelligence, 87).
project(p002, cybersecurity, 80).
project(p003, iot, 85).
project(p004, web_development, 88).
project(p005, data_science, 90).

% JUDGE FACTS
% judge(JudgeID, ExpertiseCategory)
judge(j1, artificial_intelligence).
judge(j2, cybersecurity).
judge(j3, iot).
judge(j4, web_development).
judge(j5, data_science).

% BOOTH FACTS
% booth(BoothNumber, Category)
booth(b00, artificial_intelligence).
booth(b01, cybersecurity).
booth(b02, iot).
booth(b03, web_development).
booth(b04, data_science).

% CONFLICT OF INTEREST
conflict_of_interest(j1, p001).

% ELIGIBLE AWARD CATEGORIES
eligible_award_category(artificial_intelligence).
eligible_award_category(cybersecurity).
eligible_award_category(iot).
eligible_award_category(web_development).
eligible_award_category(data_science).

% RULES
% Judge and project have the same category
qualified_judge(Judge, Project) :-
    judge(Judge, Category),
    project(Project, Category, _).


% Project and booth have the same category
valid_booth(Project, Booth) :-
    project(Project, Category, _),
    booth(Booth, Category).


% Judge can evaluate if there is no conflict
can_evaluate(Judge, Project) :-
    qualified_judge(Judge, Project),
    \+ conflict_of_interest(Judge, Project).


% Project is eligible for Best Innovation
% if score is greater than 85
eligible_project(Project) :-
    project(Project, Category, Score),
    Score > 85,
    eligible_award_category(Category).


% ==========================================
% MAIN PROGRAM
% ==========================================

:- initialization(main).

main :-
    nl,
    write('=================================================='), nl,
    write('       PROJECT ALLOCATION & JUDGING SYSTEM'), nl,
    write('=================================================='), nl,
    nl,

    matching,
    booths,
    awards,
    conflicts,

    halt.


% ==========================================
% MATCHING & ELIGIBILITY TABLE
% ==========================================

matching :-
    write('MATCHING & ELIGIBILITY'), nl,
    write('--------------------------------------------------'), nl,
    write('Project | Judge | Status'), nl,
    write('--------------------------------------------------'), nl,

    forall(
        qualified_judge(Judge, Project),
        (
            project(Project, Category, _),

            write(Project),
            write('    | '),
            write(Judge),
            write('    | '),

            (
                can_evaluate(Judge, Project)
                ->
                write('Eligible')
                ;
                write('Conflict')
            ),

            nl
        )
    ),

    nl.


% ==========================================
% BOOTH ALLOCATION TABLE
% ==========================================

booths :-
    write('BOOTH ALLOCATION'), nl,
    write('--------------------------------------------------'), nl,
    write('Project | Booth'), nl,
    write('--------------------------------------------------'), nl,

    forall(
        valid_booth(Project, Booth),
        (
            write(Project),
            write('    | '),
            write(Booth),
            nl
        )
    ),

    nl.


% ==========================================
% AWARD ELIGIBILITY TABLE
% ==========================================

awards :-
    write('BEST INNOVATION AWARD'), nl,
    write('--------------------------------------------------'), nl,
    write('Project | Score | Award Status'), nl,
    write('--------------------------------------------------'), nl,

    forall(
        project(Project, _, Score),
        (
            write(Project),
            write('    | '),
            write(Score),
            write('    | '),

            (
                eligible_project(Project)
                ->
                write('Eligible')
                ;
                write('Not Eligible')
            ),

            nl
        )
    ),

    nl.


% ==========================================
% CONFLICT CHECK TABLE
% ==========================================

conflicts :-
    write('CONFLICT CHECK'), nl,
    write('--------------------------------------------------'), nl,
    write('Judge | Project | Result'), nl,
    write('--------------------------------------------------'), nl,

    forall(
        qualified_judge(Judge, Project),
        (
            write(Judge),
            write('   | '),
            write(Project),
            write('    | '),

            (
                conflict_of_interest(Judge, Project)
                ->
                write('Conflict Found')
                ;
                write('No Conflict')
            ),

            nl
        )
    ),

    nl.
